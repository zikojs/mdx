{
  "name": "@zikojs/vite-plugin-mdx",
  "version": "0.4.2",
  "description": "Vite plugin for Zikojs MDX support",
  "keywords": [
    "zikojs",
    "mdx",
    "vite",
    "preprocessor",
    "transpiler"
  ],
  "homepage": "https://github.com/zikojs/mdx#readme",
  "bugs": {
    "url": "https://github.com/zikojs/mdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zikojs/mdx.git",
    "directory": "packages/vite-plugin-mdx"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./*": {
      "import": "./src/*/index.js",
      "types": "./src/*/index.d.ts"
    }
  },
  "license": "MIT",
  "author": "zakaria elalaoui",
  "type": "module",
  "dependencies": {
    "ziko": "catalog:",
    "vite": "catalog:",
    "@rollup/pluginutils" : "catalog:",
    "@zikojs/mdx": "workspace:*"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  }
}
