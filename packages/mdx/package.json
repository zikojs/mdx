{
  "name": "@zikojs/mdx",
  "version": "0.4.1",
  "description": "markdown preprocessor for zikojs",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.js",
    "watch": "cross-env NODE_ENV=development rollup --config rollup.config.js -w",
    "build": "cross-env NODE_ENV=production rollup --config rollup.config.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./*": {
      "import": "./src/*/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "zakaria elalaoui",
  "keywords": [
    "zikojs",
    "markdown",
    "remark",
    "mdx",
    "preprocessor",
    "astro-integration",
    "withastro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zikojs/mdx.git",
    "directory": "packages/mdx"
  },
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.18.0",
    "htmlparser2": "^12.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.62.4",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vfile-reporter": "^8.1.1",
    "ziko": "catalog:"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
